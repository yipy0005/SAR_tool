# Example only. Supply organization-managed certificates and server_name.
server {
    listen 443 ssl http2;
    server_name sar.example.org;

    ssl_certificate /etc/letsencrypt/live/sar.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sar.example.org/privkey.pem;
    client_max_body_size 5m;

    location / {
        proxy_pass http://127.0.0.1:5001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 120s;
    }
}
